# ==========================================================
# Plantilla de variables de entorno.
# Copiar como ".env" y completar con valores reales/propios.
# ==========================================================

DATABASE_URL=sqlite:///database/xavium.db
INSTITUTIONAL_EMAIL_DOMAIN=@tu-universidad.edu.co

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=
SESSION_SECRET=

PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_EXPIRATION_HOURS=12
EMAIL_VERIFICATION_TOKEN_EXPIRATION_HOURS=24

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tu-universidad.edu.co
